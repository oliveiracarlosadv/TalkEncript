<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>TalkEncript</title>
    <welcome file="bemvindo.html" mime-type="text/html"/>
    <conclusion file="conclusao.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="TalkEncript">
        <pkg-ref id="br.adv.caao.talkencript.pkg"/>
    </choice>
    <pkg-ref id="br.adv.caao.talkencript.pkg" version="__VERSAO__" onConclusion="none">talkencript-componente.pkg</pkg-ref>
</installer-gui-script>
